@page "/game"
@using Wolfgang.Conflict.Nes.Engine.Game
@using Wolfgang.Conflict.Nes.Engine.Hex
@using Wolfgang.Conflict.Nes.Engine.Players
@using Wolfgang.Conflict.Nes.Engine.Units
@using Wolfgang.Conflict.Nes.UI.Blazor.Components
@using Wolfgang.Conflict.Nes.UI.Blazor.Services
@inject ConflictService Service
@implements IDisposable

<PageTitle>Mission 01 — Conflict.NES</PageTitle>

<div class="game-page">
    <header class="game-header">
        <h1>Mission 01: First Strike</h1>
        @if (Service.CurrentState is { } s)
        {
            <div class="status">
                <span class="turn">Turn @s.TurnNumber</span>
                <span class="side @(s.NextToAct == Side.Blue ? "blue" : "red")">@s.NextToAct's turn</span>
                <span class="funds">Blue F.P.: @s.Funds[Side.Blue]</span>
                <span class="funds">Red F.P.: @s.Funds[Side.Red]</span>
            </div>
            @if (s.Phase == GamePhase.GameOver)
            {
                <div class="game-over">
                    Game over &mdash; <strong class="@(s.Winner == Side.Blue ? "blue" : "red")">@s.Winner</strong> wins.
                    <button class="start-button" @onclick="StartAsync">Play again</button>
                </div>
            }
        }
    </header>

    @if (Service.CurrentState is null)
    {
        <button class="start-button" @onclick="StartAsync">Start Mission 01</button>
    }
    else
    {
        <div class="board-and-panel">
            <HexBoardSvg State="Service.CurrentState"
                         SelectedUnitId="Service.SelectedUnitId"
                         OnHexClick="HandleHexClick" />

            @if (Service.OpenedFactory is { } fac)
            {
                <div class="production-overlay">
                    <ProductionMenu State="Service.CurrentState"
                                    Factory="fac"
                                    HumanSide="Service.HumanSide"
                                    AiPreviewTypeId="Service.AiBuildPreviewTypeId"
                                    OnBuild="BuildSelected"
                                    OnClose="Service.CloseFactoryMenu"
                                    OnSwitch="Service.SwitchFactoryView" />
                </div>
            }

            <aside class="side-panel">
                @if (Service.PendingAttack is { } pa
                     && Service.CurrentState.Units.TryGetValue(pa.AttackerId, out var atkUnit))
                {
                    <div class="attack-confirm">
                        <h2>Confirm Attack</h2>
                        @if (pa.TargetUnitId is { } tid
                             && Service.CurrentState.Units.TryGetValue(tid, out var tgtUnit))
                        {
                            var outlook = Engine.Combat.RelationsTable.Outlook(atkUnit.Category, tgtUnit.Category);
                            <p>
                                <strong class="blue">@atkUnit.Type.ShortName</strong>
                                &rarr;
                                <strong class="red">@tgtUnit.Type.ShortName</strong>
                            </p>
                            <p class="outlook">Outlook: <strong>@OutlookText(outlook)</strong></p>
                        }
                        else if (pa.TargetBuildingCoord is { } bc
                                 && Service.CurrentState.Map.Tiles.TryGetValue(bc, out var btile)
                                 && btile.Building is { } bk)
                        {
                            var bhp = Service.CurrentState.GetBuildingHitPoints(bc);
                            <p>
                                <strong class="blue">@atkUnit.Type.ShortName</strong>
                                &rarr;
                                <strong class="red">@bk</strong>
                            </p>
                            <p class="outlook">Target LIFE: <strong>@bhp / @GameState.MaxBuildingHitPoints</strong></p>
                        }
                        <div class="controls">
                            <button class="action-button attack" @onclick="Service.ConfirmAttack">Attack</button>
                            <button class="action-button" @onclick="Service.CancelAttack">Cancel</button>
                        </div>
                    </div>
                }
                else if (Service.SelectedUnitId is { } sid
                     && Service.CurrentState.Units.TryGetValue(sid, out var u))
                {
                    var stuck = u.Fuel <= 0;
                    var lowFuel = u.Fuel <= 1;

                    <h2>@u.Type.Name @(u.IsCommander ? "(H)" : string.Empty)</h2>
                    <ul class="unit-stats">
                        <li>Side: <strong class="@(u.Side == Side.Blue ? "blue" : "red")">@u.Side</strong></li>
                        <li>Class: @u.Category</li>
                        <li>LIFE: @u.HitPoints / @UnitStats.MaxHitPoints</li>
                        <li class="@(lowFuel ? "low" : null)">
                            FUEL: @u.Fuel / @u.Type.MaxFuel turns
                            @if (stuck)
                            {
                                <span class="warn"> (out of fuel)</span>
                            }
                        </li>
                        <li>SHELL: @u.Ammo / @u.Type.MaxAmmo</li>
                        <li>MOVING this turn: @u.MovesRemaining hexes</li>
                        <li>Acted: @(u.HasMoved ? "moved" : "not moved"), @(u.HasAttacked ? "attacked" : "not attacked")</li>
                    </ul>
                }
                else
                {
                    <p class="hint">@HintText</p>
                }

                @if (Service.PendingAttack is null)
                {
                    <div class="controls">
                        @if (Service.CanSupplySelected())
                        {
                            <button class="action-button supply"
                                    @onclick="Service.SupplySelected">
                                Supply (refuel + repair)
                            </button>
                        }
                        <button class="action-button"
                                disabled="@(!Service.IsHumanTurn || Service.CurrentState.Phase == GamePhase.GameOver)"
                                @onclick="EndTurnAsync">
                            End Turn
                        </button>
                        @if (Service.SelectedUnitId is not null)
                        {
                            <button class="action-button"
                                    @onclick="Service.ClearSelection">
                                Deselect
                            </button>
                        }
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Service.StateChanged += HandleStateChanged;
    }

    private void HandleStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task StartAsync() => await Service.StartMission01Async();

    private void HandleHexClick(HexCoord hex) => Service.OnHexClicked(hex);

    private async Task EndTurnAsync() => await Service.EndTurnAsync();

    private void BuildSelected(string typeId) => Service.BuildAtOpenedFactory(typeId);

    private static string OutlookText(Engine.Units.MatchupTier tier) => tier switch
    {
        Engine.Units.MatchupTier.TotalVictory => "Total Victory likely",
        Engine.Units.MatchupTier.AtAdvantage => "At advantage",
        Engine.Units.MatchupTier.Equal => "Even fight",
        Engine.Units.MatchupTier.AtDisadvantage => "At disadvantage",
        Engine.Units.MatchupTier.CompleteDefeat => "Heavy losses likely",
        _ => "Unknown",
    };

    private string HintText
    {
        get
        {
            if (Service.CurrentState?.Phase == GamePhase.GameOver) { return "Game over."; }
            if (Service.IsHumanTurn) { return "Click one of your units, then click a highlighted hex to move or a red-bordered enemy to attack."; }
            return "Red is moving...";
        }
    }

    public void Dispose()
    {
        Service.StateChanged -= HandleStateChanged;
    }
}
