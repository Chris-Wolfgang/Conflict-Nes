@using Wolfgang.Conflict.Nes.Engine.Players
@using Wolfgang.Conflict.Nes.Engine.Units
@using Wolfgang.Conflict.Nes.UI.Blazor.Rendering

@*
    Rectangular unit tile in the style of the NES original. Sized at
    UnitTileScale of the full hex. The short designation is printed
    horizontally on a dark contrast plate so it stays legible at the
    small per-hex scale; the full name is available via the hover card.
*@

<g transform="translate(@(Cx.ToString("F2", Inv)),@(Cy.ToString("F2", Inv)))">
    @* Tile body *@
    <rect x="@((-Half.W).ToString("F2", Inv))"
          y="@((-Half.H).ToString("F2", Inv))"
          width="@(Width.ToString("F2", Inv))"
          height="@(Height.ToString("F2", Inv))"
          fill="@SideColor"
          stroke="#000"
          stroke-width="1.5" />
    @* Inner highlight band so the tile reads as a chunky piece *@
    <rect x="@((-Half.W + 2).ToString("F2", Inv))"
          y="@((-Half.H + 2).ToString("F2", Inv))"
          width="@((Width - 4).ToString("F2", Inv))"
          height="@((Height - 4).ToString("F2", Inv))"
          fill="none"
          stroke="@SideDarkColor"
          stroke-width="1" />

    @* Dark contrast plate behind the label. *@
    <rect x="@((-Half.W - 3).ToString("F2", Inv))"
          y="-7"
          width="@((Width + 6).ToString("F2", Inv))"
          height="14"
          rx="2"
          fill="#101018"
          opacity="0.82" />

    @* Horizontal unit designation. Razor's <text> block syntax conflicts
       with the SVG <text> element, so it is emitted as a MarkupString. *@
    @NameText

    @if (Unit.IsCommander)
    {
        <rect x="@((-Half.W + 1.5).ToString("F2", Inv))"
              y="@((-Half.H + 1.5).ToString("F2", Inv))"
              width="9" height="8"
              fill="@NesPalette.Selection"
              stroke="#000"
              stroke-width="0.8" />
        @CommanderBadge
    }

    @if (Unit.HitPoints < UnitStats.MaxHitPoints)
    {
        <rect x="@((-Half.W + 1).ToString("F2", Inv))"
              y="@((Half.H + 1).ToString("F2", Inv))"
              width="@((Width - 2).ToString("F2", Inv))"
              height="3" fill="#000" />
        <rect x="@((-Half.W + 1).ToString("F2", Inv))"
              y="@((Half.H + 1).ToString("F2", Inv))"
              width="@HpBarWidth.ToString("F2", Inv)" height="3"
              fill="@HpBarColor" />
    }
</g>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public Unit Unit { get; set; } = default!;
    [Parameter] public double Cx { get; set; }
    [Parameter] public double Cy { get; set; }

    private static double Width => HexLayout.HexSize * HexLayout.UnitTileScale;
    private static double Height => HexLayout.HexHeight * HexLayout.UnitTileScale;
    private static (double W, double H) Half => (Width / 2.0, Height / 2.0);

    private string SideColor => Unit.Side == Side.Blue ? NesPalette.BlueSide : NesPalette.RedSide;
    private string SideDarkColor => Unit.Side == Side.Blue ? NesPalette.BlueSideDark : NesPalette.RedSideDark;

    private string UnitName => Unit.Type.ShortName.ToUpperInvariant();

    private MarkupString NameText
    {
        get
        {
            // Horizontal, bold, white on the dark plate. Font shrinks a step
            // for longer designations so they stay inside the plate.
            var fontSize = UnitName.Length >= 6 ? 6.5 : 8.0;
            var svg = $"<text x=\"0\" y=\"3\" fill=\"#ffffff\" " +
                      $"font-family=\"Consolas,monospace\" font-weight=\"700\" " +
                      $"font-size=\"{fontSize.ToString("0.0", Inv)}\" letter-spacing=\"-0.3\" " +
                      $"text-anchor=\"middle\">{UnitName}</text>";
            return new MarkupString(svg);
        }
    }

    private static MarkupString CommanderBadge
    {
        get
        {
            var x = (-Half.W + 6).ToString("F2", Inv);
            var y = (-Half.H + 8).ToString("F2", Inv);
            var svg = $"<text x=\"{x}\" y=\"{y}\" " +
                      $"fill=\"#000\" font-family=\"Consolas,monospace\" font-weight=\"700\" " +
                      $"font-size=\"8\" text-anchor=\"middle\">H</text>";
            return new MarkupString(svg);
        }
    }

    private double HpBarWidth => (Width - 2) * Math.Max(0, Unit.HitPoints) / (double)UnitStats.MaxHitPoints;

    private string HpBarColor
    {
        get
        {
            if (Unit.HitPoints >= 10) { return "#3cd44c"; }
            if (Unit.HitPoints >= 5) { return "#d4b020"; }
            return NesPalette.Damage;
        }
    }
}
