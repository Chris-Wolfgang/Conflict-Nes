@using Wolfgang.Conflict.Nes.Engine.Players
@using Wolfgang.Conflict.Nes.Engine.Units
@using Wolfgang.Conflict.Nes.UI.Blazor.Rendering

@*
    Original chunky unit glyphs. Each kind has a distinct silhouette so the
    player can read the board at a glance. Side colour is the fill.
*@

<g transform="translate(@(Cx.ToString("F2", Inv)),@(Cy.ToString("F2", Inv)))">
    @switch (Unit.Kind)
    {
        case UnitKind.Infantry:
            <circle cx="0" cy="-3" r="4" fill="@SideColor" stroke="#000" stroke-width="1.2" />
            <rect x="-4" y="0" width="8" height="9" fill="@SideColor" stroke="#000" stroke-width="1.2" />
            break;

        case UnitKind.Tank:
            <rect x="-11" y="-3" width="22" height="9" rx="1.5" fill="@SideColor" stroke="#000" stroke-width="1.5" />
            <rect x="-7" y="-9" width="14" height="6" rx="1.5" fill="@SideDarkColor" stroke="#000" stroke-width="1.2" />
            <rect x="2" y="-7" width="12" height="2" fill="#000" />
            @if (Unit.IsCommander)
            {
                <rect x="-3" y="-13" width="6" height="3" fill="@NesPalette.Selection" stroke="#000" stroke-width="0.8" />
                <polygon points="0,-15 -2.5,-12.5 2.5,-12.5" fill="@NesPalette.Selection" stroke="#000" stroke-width="0.8" />
            }
            break;

        case UnitKind.Helicopter:
            <rect x="-9" y="-2" width="18" height="6" rx="2.5" fill="@SideColor" stroke="#000" stroke-width="1.2" />
            <rect x="-12" y="-6" width="24" height="1.5" fill="#000" />
            <rect x="-1" y="-9" width="2" height="4" fill="#000" />
            <rect x="3" y="4" width="2" height="4" fill="#000" />
            break;

        case UnitKind.Fighter:
            <polygon points="-13,4 0,-10 13,4 7,4 0,-2 -7,4" fill="@SideColor" stroke="#000" stroke-width="1.2" />
            <rect x="-1" y="-2" width="2" height="9" fill="@SideDarkColor" />
            break;
    }

    @* HP bar - only show if below max *@
    @if (Unit.HitPoints < UnitStats.MaxHitPoints)
    {
        <rect x="-12" y="11" width="24" height="3" fill="#000" />
        <rect x="-12" y="11" width="@HpBarWidth.ToString("F2", Inv)" height="3" fill="@HpBarColor" />
    }
</g>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public Unit Unit { get; set; } = default!;
    [Parameter] public double Cx { get; set; }
    [Parameter] public double Cy { get; set; }

    private string SideColor => Unit.Side == Side.Blue ? NesPalette.BlueSide : NesPalette.RedSide;
    private string SideDarkColor => Unit.Side == Side.Blue ? NesPalette.BlueSideDark : NesPalette.RedSideDark;

    private double HpBarWidth => 24.0 * Math.Max(0, Unit.HitPoints) / (double)UnitStats.MaxHitPoints;

    private string HpBarColor
    {
        get
        {
            if (Unit.HitPoints >= 10) { return "#3cd44c"; }
            if (Unit.HitPoints >= 5) { return "#d4b020"; }
            return NesPalette.Damage;
        }
    }
}
