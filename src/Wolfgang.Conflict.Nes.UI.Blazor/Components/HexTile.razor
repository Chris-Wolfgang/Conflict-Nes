@using System.Globalization
@using Wolfgang.Conflict.Nes.Engine.Map
@using Wolfgang.Conflict.Nes.UI.Blazor.Rendering

@*
    A single hex polygon plus terrain ornamentation. Forest is a dense
    two-tone canopy; mountains are jagged two-tone peaks — both styled to
    evoke the 1991 Conflict map art.
*@

<g>
    <polygon points="@Points"
             fill="@TerrainColors.FillFor(Tile.Terrain)"
             stroke="@TerrainColors.StrokeFor(Tile.Terrain)"
             stroke-width="1" />

    @switch (Tile.Terrain)
    {
        case Terrain.Forest:
            @foreach (var (dx, dy) in ForestClumps)
            {
                <circle cx="@F(Cx + dx)" cy="@F(Cy + dy)" r="5" fill="@NesPalette.ForestDark" />
                <circle cx="@F(Cx + dx)" cy="@F(Cy + dy - 1.6)" r="2.6" fill="@NesPalette.ForestLight" />
            }
            break;

        case Terrain.Mountain:
            @foreach (var peak in MountainPeaks)
            {
                <polygon points="@PeakLightFace(peak)" fill="@NesPalette.MountainLight" />
                <polygon points="@PeakDarkFace(peak)" fill="@NesPalette.MountainDark" />
            }
            break;

        case Terrain.Road:
            // Brown ribbon across the hex with a dashed centre line.
            <rect x="@F(Cx - 14)" y="@F(Cy - 4)" width="28" height="8"
                  fill="@NesPalette.Road" stroke="@NesPalette.MountainDark" stroke-width="0.6" />
            <line x1="@F(Cx - 11)" y1="@F(Cy)" x2="@F(Cx - 5)" y2="@F(Cy)"
                  stroke="@NesPalette.Text" stroke-width="0.8" />
            <line x1="@F(Cx - 1)" y1="@F(Cy)" x2="@F(Cx + 5)" y2="@F(Cy)"
                  stroke="@NesPalette.Text" stroke-width="0.8" />
            <line x1="@F(Cx + 9)" y1="@F(Cy)" x2="@F(Cx + 13)" y2="@F(Cy)"
                  stroke="@NesPalette.Text" stroke-width="0.8" />
            break;

        case Terrain.River:
            // Two darker wavy lines suggest current.
            <path d="@RiverPath(Cy - 3)" stroke="@NesPalette.Reef" stroke-width="1.4"
                  fill="none" stroke-linecap="round" />
            <path d="@RiverPath(Cy + 4)" stroke="@NesPalette.Reef" stroke-width="1.4"
                  fill="none" stroke-linecap="round" />
            break;

        case Terrain.Bridge:
            // River under, with a road span and railings.
            <path d="@RiverPath(Cy + 7)" stroke="@NesPalette.Reef" stroke-width="1.2"
                  fill="none" stroke-linecap="round" />
            <rect x="@F(Cx - 14)" y="@F(Cy - 5)" width="28" height="10"
                  fill="@NesPalette.Road" stroke="@NesPalette.MountainDark" stroke-width="0.6" />
            <line x1="@F(Cx - 14)" y1="@F(Cy - 6)" x2="@F(Cx + 14)" y2="@F(Cy - 6)"
                  stroke="@NesPalette.MountainDark" stroke-width="0.8" />
            <line x1="@F(Cx - 14)" y1="@F(Cy + 6)" x2="@F(Cx + 14)" y2="@F(Cy + 6)"
                  stroke="@NesPalette.MountainDark" stroke-width="0.8" />
            break;

        case Terrain.Shoal:
            // Three little wave caps on a sandy backdrop.
            @foreach (var (dx, dy) in WaveCaps)
            {
                <path d="@WavePath(Cx + dx, Cy + dy)" stroke="@NesPalette.Sea"
                      stroke-width="0.9" fill="none" stroke-linecap="round" />
            }
            break;

        case Terrain.Sea:
            // Three longer wave lines across the hex.
            @foreach (var dy in SeaWaves)
            {
                <path d="@RiverPath(Cy + dy)" stroke="@NesPalette.Reef"
                      stroke-width="1.0" fill="none" stroke-linecap="round" />
            }
            break;

        case Terrain.Reef:
            // Dark sea with three rocky outcrops.
            @foreach (var (dx, dy) in ReefRocks)
            {
                <circle cx="@F(Cx + dx)" cy="@F(Cy + dy)" r="3.5" fill="@NesPalette.MountainDark" />
                <circle cx="@F(Cx + dx - 1)" cy="@F(Cy + dy - 1)" r="1.4" fill="@NesPalette.MountainLight" />
            }
            break;
    }
</g>

@code {
    [Parameter] public Tile Tile { get; set; } = default!;
    [Parameter] public string Points { get; set; } = string.Empty;
    [Parameter] public double Cx { get; set; }
    [Parameter] public double Cy { get; set; }

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static string F(double value) => value.ToString("F2", Inv);

    // Tree-clump centre offsets relative to the hex centre — a dense canopy.
    private static readonly (double Dx, double Dy)[] ForestClumps =
    [
        (-9, -3), (-1, -6), (7, -3),
        (-6, 4), (2, 3), (10, 4),
        (-1, 10),
    ];

    // Mountain peaks as (Dx, BaseY, Height, HalfWidth) relative to hex centre.
    private static readonly (double Dx, double BaseY, double Height, double HalfWidth)[] MountainPeaks =
    [
        (-8, 8, 16, 9),
        (2, 9, 22, 11),
        (11, 7, 13, 8),
    ];

    // Left (sunlit) face of a peak: apex -> base-left -> base-middle.
    private string PeakLightFace((double Dx, double BaseY, double Height, double HalfWidth) p)
    {
        var apexX = Cx + p.Dx;
        var apexY = Cy + p.BaseY - p.Height;
        var baseLeftX = Cx + p.Dx - p.HalfWidth;
        var baseY = Cy + p.BaseY;
        var baseMidX = Cx + p.Dx;
        return $"{F(apexX)},{F(apexY)} {F(baseLeftX)},{F(baseY)} {F(baseMidX)},{F(baseY)}";
    }

    // Right (shaded) face of a peak: apex -> base-middle -> base-right.
    private string PeakDarkFace((double Dx, double BaseY, double Height, double HalfWidth) p)
    {
        var apexX = Cx + p.Dx;
        var apexY = Cy + p.BaseY - p.Height;
        var baseMidX = Cx + p.Dx;
        var baseY = Cy + p.BaseY;
        var baseRightX = Cx + p.Dx + p.HalfWidth;
        return $"{F(apexX)},{F(apexY)} {F(baseMidX)},{F(baseY)} {F(baseRightX)},{F(baseY)}";
    }

    // Three small wave-cap positions on a Shoal hex.
    private static readonly (double Dx, double Dy)[] WaveCaps =
    [
        (-6, -2), (4, 1), (-2, 6),
    ];

    // Three vertical offsets at which to draw a Sea wave line.
    private static readonly double[] SeaWaves = [-6, 0, 6];

    // Three reef-rock positions inside a Reef hex.
    private static readonly (double Dx, double Dy)[] ReefRocks =
    [
        (-7, 0), (5, -4), (3, 6),
    ];

    // Sinusoid path across the hex at the given y, used for water lines.
    private string RiverPath(double y)
    {
        var p = F;
        return $"M {p(Cx - 14)} {p(y)} Q {p(Cx - 7)} {p(y - 3)} {p(Cx)} {p(y)} T {p(Cx + 14)} {p(y)}";
    }

    // A small ~^~ cap for a beach wave.
    private static string WavePath(double cx, double cy)
    {
        return $"M {F(cx - 3)} {F(cy)} Q {F(cx - 1.5)} {F(cy - 2)} {F(cx)} {F(cy)} T {F(cx + 3)} {F(cy)}";
    }
}
