@using Wolfgang.Conflict.Nes.Engine.Game
@using Wolfgang.Conflict.Nes.Engine.Hex
@using Wolfgang.Conflict.Nes.Engine.Map
@using Wolfgang.Conflict.Nes.Engine.Players
@using Wolfgang.Conflict.Nes.Engine.Rules
@using Wolfgang.Conflict.Nes.Engine.Units

@*
    Production screen for one factory. Shows six slots; affordable ones
    show the unit's name + cost, the rest just show a blank placeholder
    (no cost — the player can browse to see what's available but isn't
    told the locked price until they can afford it).

    Workflow: tap a slot to select it (yellow outline), then commit with
    the Build button or back out with Cancel.
*@

@if (State is null || Factory is null)
{
    return;
}

@{
    var side = State.GetBuildingOwner(Factory.Value) ?? State.NextToAct;
    var tile = State.Map.Tiles[Factory.Value];
    var buildingKind = tile.Building ?? BuildingKind.LandFactory;
    var roster = ProductionRules.ProducibleAt(State.Catalog, buildingKind, side);
    var funds = State.Funds.TryGetValue(side, out var fp) ? fp : 0;
    // What the side ordered THIS turn (still pending materialisation on
    // the next turn). We mark its slot with the built-outline so the
    // player sees what they bought even though no unit appears on the
    // hex until the next round.
    var builtTypeId = string.Empty;
    if (State.PendingProduction.TryGetValue(side, out var pending) && pending.FactoryCoord == Factory.Value)
    {
        builtTypeId = pending.TypeId;
    }
    var sideAlreadyBuilt = State.HasBuiltThisTurn(side);
    // The AI preview only counts as "active" when it really is the AI's
    // turn. Stuck-on preview state from a prior turn must never lock the
    // menu controls during the human's turn (Cancel / Build / tabs).
    var aiActive = AiPreviewTypeId is not null && State.NextToAct != HumanSide;
    // A unit on the factory hex blocks production. The engine rejects it
    // with an exception, so the UI must gate the Build button itself.
    var factoryOccupied = State.GetUnitAt(Factory.Value) is not null;
    var canCommit = !sideAlreadyBuilt && !aiActive && !factoryOccupied && side == HumanSide && _selectedTypeId is not null;
}

<div class="production-menu @(side == Side.Blue ? "blue" : "red")">
    <div class="production-header">
        <h2>@side &mdash; Production</h2>
        <div class="production-funds">F.P. @funds</div>
    </div>

    @if (aiActive)
    {
        <div class="ai-build-banner">
            &#9654; RED IS BUILDING THIS &#9664;
        </div>
    }

    @if (side == HumanSide)
    {
        <div class="factory-tabs">
            <button class="factory-tab @(buildingKind == BuildingKind.LandFactory ? "active" : null)"
                    type="button"
                    disabled="@(aiActive || buildingKind == BuildingKind.LandFactory)"
                    @onclick="@(() => OnSwitch.InvokeAsync(BuildingKind.LandFactory))">
                Land Factory
            </button>
            <button class="factory-tab @(buildingKind == BuildingKind.AirFactory ? "active" : null)"
                    type="button"
                    disabled="@(aiActive || buildingKind == BuildingKind.AirFactory)"
                    @onclick="@(() => OnSwitch.InvokeAsync(BuildingKind.AirFactory))">
                Air Factory
            </button>
        </div>
    }
    else
    {
        <div class="factory-tabs">
            <span class="factory-tab active">@(buildingKind == BuildingKind.AirFactory ? "Air Factory" : "Land Factory")</span>
        </div>
    }

    <div class="production-grid">
        @foreach (var def in roster)
        {
            var affordable = def.ProductionCost <= funds;
            var isBuilt = string.Equals(def.Id, builtTypeId, StringComparison.Ordinal);
            var isAiPreview = string.Equals(def.Id, AiPreviewTypeId, StringComparison.Ordinal);
            var isSelected = string.Equals(def.Id, _selectedTypeId, StringComparison.Ordinal);
            var slotClass = "production-slot"
                + (affordable ? " affordable" : " empty")
                + (isBuilt ? " built" : string.Empty)
                + (isAiPreview ? " ai-preview" : string.Empty)
                + (isSelected ? " selected" : string.Empty);

            <button class="@slotClass"
                    type="button"
                    disabled="@(!affordable || isBuilt || aiActive || sideAlreadyBuilt || side != HumanSide)"
                    @onclick="@(_ => SelectSlot(def.Id))">
                @if (affordable || isBuilt || isAiPreview)
                {
                    <div class="slot-name">@def.ShortName</div>
                    <div class="slot-cost">@def.ProductionCost F.P.</div>
                }
                else
                {
                    <div class="slot-empty-marker">&mdash;</div>
                }
            </button>
        }
    </div>

    <div class="production-footer">
        @if (aiActive)
        {
            <div class="production-hint">Red is building&hellip;</div>
        }
        else if (sideAlreadyBuilt)
        {
            <div class="production-hint">Built this turn. Cancel to close.</div>
        }
        else if (factoryOccupied && side == HumanSide)
        {
            <div class="production-hint">Factory blocked &mdash; move the unit on this hex first.</div>
        }
        else if (side == HumanSide)
        {
            <div class="production-hint">@(_selectedTypeId is null ? "Tap a unit to select it." : "Press Build to confirm.")</div>
        }
        else
        {
            <div class="production-hint">Viewing enemy factory.</div>
        }
        <div class="footer-buttons">
            <button class="action-button build"
                    type="button"
                    disabled="@(!canCommit)"
                    @onclick="ConfirmBuild">
                Build
            </button>
            <button class="action-button"
                    type="button"
                    disabled="@aiActive"
                    @onclick="OnClose">
                Cancel
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public GameState? State { get; set; }
    [Parameter] public HexCoord? Factory { get; set; }
    [Parameter] public Side HumanSide { get; set; } = Side.Blue;
    [Parameter] public string? AiPreviewTypeId { get; set; }
    [Parameter] public EventCallback<string> OnBuild { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<BuildingKind> OnSwitch { get; set; }

    /// <summary>Catalog id of the slot the player has selected (not yet committed).</summary>
    private string? _selectedTypeId;

    /// <summary>The factory hex the current selection belongs to — clears on switch.</summary>
    private HexCoord? _selectionFactory;

    protected override void OnParametersSet()
    {
        // Clear the in-flight selection if the player navigated to a
        // different factory, so a stale highlight doesn't carry over.
        if (_selectionFactory != Factory)
        {
            _selectedTypeId = null;
            _selectionFactory = Factory;
        }
    }

    private void SelectSlot(string typeId)
    {
        _selectedTypeId = string.Equals(_selectedTypeId, typeId, StringComparison.Ordinal)
            ? null  // tapping the selected slot again deselects.
            : typeId;
    }

    private async Task ConfirmBuild()
    {
        if (_selectedTypeId is { } id)
        {
            await OnBuild.InvokeAsync(id);
            _selectedTypeId = null;
        }
    }
}
