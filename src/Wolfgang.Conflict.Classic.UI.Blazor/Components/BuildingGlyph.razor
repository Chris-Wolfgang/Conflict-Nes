@using Wolfgang.Conflict.Classic.Engine.Map
@using Wolfgang.Conflict.Classic.Engine.Players
@using Wolfgang.Conflict.Classic.UI.Blazor.Rendering

@*
    Original NES-feel building glyphs. Each kind has a distinct silhouette so
    the player can tell them apart at a glance without copying NES sprites.

    City        : two stacked apartment blocks with windows (densely populated).
    HQ          : flag-topped fortress.
    AirFactory  : runway with stripes, a small control tower, and a hangar.
    Port        : dock with pylon.
    LandFactory : long building with a smoking chimney.
*@

<g transform="translate(@(Cx.ToString("F2", Inv)),@(Cy.ToString("F2", Inv)))">
    @switch (Kind)
    {
        case BuildingKind.City:
            @* Taller back tower (enlarged so the city reads as the biggest building) *@
            <rect x="-17" y="-21" width="15" height="30" fill="@OwnerColor" stroke="#000" stroke-width="1.5" />
            <rect x="-14" y="-17" width="3" height="3" fill="#fff8" />
            <rect x="-8" y="-17" width="3" height="3" fill="#fff8" />
            <rect x="-14" y="-11" width="3" height="3" fill="#fff8" />
            <rect x="-8" y="-11" width="3" height="3" fill="#fff8" />
            <rect x="-14" y="-5" width="3" height="3" fill="#fff8" />
            <rect x="-8" y="-5" width="3" height="3" fill="#fff8" />
            <rect x="-14" y="1" width="3" height="3" fill="#fff8" />
            <rect x="-8" y="1" width="3" height="3" fill="#fff8" />
            @* Front shorter wing *@
            <rect x="-3" y="-11" width="21" height="20" fill="@OwnerDarkColor" stroke="#000" stroke-width="1.5" />
            <rect x="0" y="-7" width="3" height="3" fill="#fff8" />
            <rect x="6" y="-7" width="3" height="3" fill="#fff8" />
            <rect x="12" y="-7" width="3" height="3" fill="#fff8" />
            <rect x="0" y="-1" width="3" height="3" fill="#fff8" />
            <rect x="6" y="-1" width="3" height="3" fill="#fff8" />
            <rect x="12" y="-1" width="3" height="3" fill="#fff8" />
            <rect x="0" y="5" width="3" height="3" fill="#fff8" />
            <rect x="6" y="5" width="3" height="3" fill="#fff8" />
            <rect x="12" y="5" width="3" height="3" fill="#fff8" />
            break;

        case BuildingKind.Hq:
            @* Fortress with flag *@
            <rect x="-14" y="-10" width="28" height="20" fill="@OwnerColor" stroke="#000" stroke-width="2" />
            <rect x="-14" y="-13" width="4" height="3" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            <rect x="-7" y="-13" width="4" height="3" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            <rect x="-1" y="-13" width="4" height="3" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            <rect x="5" y="-13" width="4" height="3" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            <rect x="10" y="-13" width="4" height="3" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            @* Flagpole + flag *@
            <rect x="-0.5" y="-22" width="1" height="9" fill="#000" />
            <polygon points="0.5,-22 8,-19 0.5,-16" fill="@OwnerDarkColor" stroke="#000" stroke-width="0.8" />
            @* Gate/door *@
            <rect x="-4" y="0" width="8" height="10" fill="#000" />
            break;

        case BuildingKind.AirFactory:
            @* Large arched hangar in the side colour — same visual weight
               as the Land Factory so the player reads it as a factory.
               A short tarmac strip at the bottom plus a control-tower
               window distinguish it from the chimney-style land factory. *@
            <rect x="-14" y="-12" width="28" height="18" fill="@OwnerColor" stroke="#000" stroke-width="1.5" />
            @* Arched (rounded) roof in the darker shade *@
            <path d="M -14,-12 Q 0,-22 14,-12 L 14,-9 L -14,-9 Z"
                  fill="@OwnerDarkColor" stroke="#000" stroke-width="1.2" />
            @* Hangar doors *@
            <rect x="-9" y="-3" width="6" height="9" fill="#0008" />
            <rect x="3" y="-3" width="6" height="9" fill="#0008" />
            <rect x="-3" y="-7" width="6" height="2" fill="#fff8" />
            @* Tarmac strip below the hangar with two centre-line dashes *@
            <rect x="-16" y="6" width="32" height="4" fill="#3a3a40" stroke="#000" stroke-width="1.0" />
            <rect x="-9" y="7.5" width="4" height="1" fill="#fff" />
            <rect x="-1" y="7.5" width="4" height="1" fill="#fff" />
            <rect x="7" y="7.5" width="4" height="1" fill="#fff" />
            break;

        case BuildingKind.Port:
            <rect x="-12" y="-3" width="24" height="6" fill="@OwnerColor" stroke="#000" stroke-width="1.2" />
            <rect x="-2" y="-12" width="4" height="14" fill="@OwnerDarkColor" stroke="#000" stroke-width="1" />
            break;

        case BuildingKind.LandFactory:
            <rect x="-13" y="-8" width="26" height="18" fill="@OwnerColor" stroke="#000" stroke-width="1.5" />
            <rect x="6" y="-15" width="5" height="10" fill="@OwnerDarkColor" stroke="#000" stroke-width="1" />
            <circle cx="8.5" cy="-17" r="2" fill="#888" opacity="0.7" />
            <circle cx="10" cy="-19" r="2.5" fill="#888" opacity="0.5" />
            <rect x="-9" y="-3" width="6" height="6" fill="#fff8" />
            <rect x="-1" y="-3" width="6" height="6" fill="#fff8" />
            break;
    }
</g>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public BuildingKind Kind { get; set; }
    [Parameter] public Side? Owner { get; set; }
    [Parameter] public double Cx { get; set; }
    [Parameter] public double Cy { get; set; }

    private string OwnerColor => Owner switch
    {
        Side.Blue => NesPalette.BlueSide,
        Side.Red => NesPalette.RedSide,
        _ => NesPalette.NeutralBuilding,
    };

    private string OwnerDarkColor => Owner switch
    {
        Side.Blue => NesPalette.BlueSideDark,
        Side.Red => NesPalette.RedSideDark,
        _ => "#604018",
    };
}
