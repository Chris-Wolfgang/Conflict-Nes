@using System.Globalization
@using Wolfgang.Conflict.Classic.Engine.Game
@using Wolfgang.Conflict.Classic.Engine.Hex
@using Wolfgang.Conflict.Classic.Engine.Map
@using Wolfgang.Conflict.Classic.Engine.Rules
@using Wolfgang.Conflict.Classic.Engine.Units
@using Wolfgang.Conflict.Classic.UI.Blazor.Rendering

@*
    Top-level board renderer. Walks the map in z-order: terrain ->
    movement/attack overlays -> buildings -> units -> selection ring.
    Each hex is also a transparent click target.
*@

@{
    var size = HexLayout.BoardSize(State.Map.Width, State.Map.Height);
    var viewBox = $"0 0 {size.Width.ToString("F2", Inv)} {size.Height.ToString("F2", Inv)}";
    var reachable = ReachableSet();
    var attackable = AttackableSet();
}

<svg class="hex-board"
     xmlns="http://www.w3.org/2000/svg"
     viewBox="@viewBox"
     width="@($"{size.Width.ToString("F0", Inv)}")"
     height="@($"{size.Height.ToString("F0", Inv)}")"
     preserveAspectRatio="xMidYMid meet">

    <rect width="100%" height="100%" fill="@NesPalette.Background" />

    @* Layer 1: terrain *@
    @foreach (var (coord, tile) in OrderedTiles())
    {
        var centre = HexLayout.Centre(coord);
        <HexTile Tile="tile" Points="@HexLayout.PolygonPoints(centre)" Cx="centre.X" Cy="centre.Y" />
    }

    @* Layer 2: movement and attack overlays *@
    @foreach (var hex in reachable)
    {
        var centre = HexLayout.Centre(hex);
        <polygon points="@HexLayout.PolygonPoints(centre)"
                 fill="@NesPalette.BlueSide" fill-opacity="0.30"
                 stroke="@NesPalette.BlueSide" stroke-width="1.2"
                 pointer-events="none" />
    }
    @foreach (var hex in attackable)
    {
        var centre = HexLayout.Centre(hex);
        <polygon points="@HexLayout.PolygonPoints(centre)"
                 fill="@NesPalette.Damage" fill-opacity="0.35"
                 stroke="@NesPalette.Damage" stroke-width="1.5"
                 pointer-events="none" />
    }

    @* Layer 3: buildings *@
    @foreach (var (coord, tile) in OrderedTiles())
    {
        if (tile.Building is { } building)
        {
            var c = HexLayout.Centre(coord);
            var owner = State.GetBuildingOwner(coord);
            <BuildingGlyph Kind="building" Owner="owner" Cx="c.X" Cy="c.Y" />
        }
    }

    @* Layer 4: units *@
    @foreach (var unit in State.Units.Values)
    {
        var c = HexLayout.Centre(unit.Coord);
        <UnitGlyph Unit="unit" Cx="c.X" Cy="c.Y" />
    }

    @* Layer 5: selection ring on the selected unit's hex *@
    @if (SelectedUnitId is { } sid && State.Units.TryGetValue(sid, out var selected))
    {
        var centre = HexLayout.Centre(selected.Coord);
        <polygon points="@HexLayout.PolygonPoints(centre)"
                 fill="none" stroke="@NesPalette.Selection" stroke-width="3"
                 pointer-events="none" />
    }

    @* Layer 6: click + hover targets (transparent, full hex area) *@
    @foreach (var (coord, _) in OrderedTiles())
    {
        var centre = HexLayout.Centre(coord);
        var hex = coord;
        <polygon points="@HexLayout.PolygonPoints(centre)"
                 fill="transparent"
                 stroke="transparent"
                 style="cursor:pointer"
                 @onclick="@(_ => OnHexClick.InvokeAsync(hex))"
                 @onmouseover="@(() => _hoveredHex = hex)"
                 @onmouseout="@(() => ClearHover(hex))" />
    }

    @* Layer 7: hover cue card for the unit under the cursor *@
    @if (HoveredUnit is { } hu)
    {
        var hc = HexLayout.Centre(hu.Coord);
        var cardOnLeft = hc.X > size.Width * 0.6;
        var cardX = cardOnLeft ? hc.X - 158 : hc.X + 22;
        var cardY = Math.Max(2.0, hc.Y - 52);
        <foreignObject x="@F(cardX)" y="@F(cardY)" width="150" height="104">
            <div xmlns="http://www.w3.org/1999/xhtml"
                 class="unit-cue-card @(hu.Side == Engine.Players.Side.Blue ? "blue" : "red")">
                <div class="cue-name">@hu.Type.Name</div>
                <div class="cue-sub">@hu.Side &#183; @hu.Category@(hu.IsCommander ? " (HQ)" : string.Empty)</div>
                <div class="cue-stats">
                    <span>LIFE @hu.HitPoints/@UnitStats.MaxHitPoints</span>
                    <span>FUEL @hu.Fuel/@hu.Type.MaxFuel</span>
                    <span>SHELL @hu.Ammo/@hu.Type.MaxAmmo</span>
                    <span>MOVE @hu.MovesRemaining</span>
                </div>
                <div class="cue-status">@StatusLine(hu)</div>
            </div>
        </foreignObject>
    }
</svg>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    [Parameter] public GameState State { get; set; } = default!;
    [Parameter] public UnitId? SelectedUnitId { get; set; }
    [Parameter] public EventCallback<HexCoord> OnHexClick { get; set; }

    private HexCoord? _hoveredHex;

    private static string F(double value) => value.ToString("F2", Inv);

    private Unit? HoveredUnit => _hoveredHex is { } h ? State.GetUnitAt(h) : null;

    private void ClearHover(HexCoord hex)
    {
        if (_hoveredHex == hex)
        {
            _hoveredHex = null;
        }
    }

    private static string StatusLine(Unit unit)
    {
        if (unit.Fuel <= 0)
        {
            return "Out of fuel";
        }
        var moved = unit.HasMoved ? "moved" : "ready";
        var attacked = unit.HasAttacked ? "fired" : "armed";
        return $"{moved}, {attacked}";
    }

    private IEnumerable<(HexCoord Coord, Tile Tile)> OrderedTiles()
    {
        foreach (var coord in MapDefinition.EnumerateCoords(State.Map.Width, State.Map.Height))
        {
            if (State.Map.Tiles.TryGetValue(coord, out var tile))
            {
                yield return (coord, tile);
            }
        }
    }

    private HashSet<HexCoord> ReachableSet()
    {
        var set = new HashSet<HexCoord>();
        if (SelectedUnitId is { } sid
            && State.Units.TryGetValue(sid, out var unit)
            && !unit.HasMoved)
        {
            foreach (var h in MovementRules.GetReachable(State, unit))
            {
                set.Add(h);
            }
        }
        return set;
    }

    private HashSet<HexCoord> AttackableSet()
    {
        var set = new HashSet<HexCoord>();
        if (SelectedUnitId is { } sid
            && State.Units.TryGetValue(sid, out var unit)
            && !unit.HasAttacked)
        {
            foreach (var targetId in AttackRules.GetLegalTargets(State, unit))
            {
                set.Add(State.Units[targetId].Coord);
            }
            foreach (var hex in AttackRules.GetAttackableBuildings(State, unit))
            {
                set.Add(hex);
            }
        }
        return set;
    }
}
